# ---------------------------------------------------------------------------
# VI.mate signaling server
# Copy to `.env` and adjust. Every value below has a working default for local
# development, so an empty .env still boots.
# ---------------------------------------------------------------------------

# Port the signaling server listens on.
PORT=8000

# Comma-separated list of origins allowed to connect (CORS + Socket.IO).
# Use exact origins in production — never "*" with credentials enabled.
# Example: https://vimate.example.com,https://www.vimate.example.com
#
# Only consulted verbatim when NODE_ENV=production. Outside production, any
# loopback or private-network origin is also accepted on any port and either
# scheme, so `npm run dev`, `npm run preview`, a dev certificate, and a phone
# joining over the LAN all work without editing this line. Public origins are
# rejected in both modes.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Trust X-Forwarded-For when behind a reverse proxy / load balancer (fly.io,
# render, nginx, Cloudflare). Set to 1 when proxied, 0 when directly exposed.
TRUST_PROXY=0


# ---------------------------------------------------------------------------
# ICE / NAT traversal
#
# The browser needs these to punch through NAT. They are served to clients at
# GET /api/ice so that TURN credentials are NOT baked into the frontend bundle.
#
# STUN alone is enough for most home networks. It is NOT enough for symmetric
# NAT, carrier-grade NAT, or corporate firewalls that block UDP — roughly
# 8-20% of real users. Those users need TURN or the call silently never
# connects. Configure TURN before you put this in front of real people.
# ---------------------------------------------------------------------------

# Comma-separated STUN URLs.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- TURN, option A: static long-term credentials ---------------------------
# Simplest to set up. The same username/password is handed to every client,
# so only use it when the TURN server itself is access-controlled.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=vimate
# TURN_CREDENTIAL=change-me

# --- TURN, option B: ephemeral HMAC credentials (recommended) ---------------
# Implements coturn's REST API (`use-auth-secret`). The server mints a
# short-lived username/password pair per client; leaked credentials expire on
# their own. TURN_SECRET must match coturn's `static-auth-secret`.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=a-long-random-shared-secret
# TURN_TTL_SECONDS=86400

# Force all media through TURN. Useful to verify your TURN server actually
# works (set to "relay"), and for privacy-sensitive deployments where peers
# must not learn each other's IPs. Costs bandwidth — TURN relays every byte.
# Valid values: all | relay
ICE_TRANSPORT_POLICY=all


# ---------------------------------------------------------------------------
# Limits — these are the abuse backstops. Tune, don't remove.
# ---------------------------------------------------------------------------

# Maximum participants in a single room (mesh WebRTC degrades past ~8).
MAX_PARTICIPANTS=12

# Maximum chat message length, in characters.
MAX_MESSAGE_LENGTH=2000

# How many chat messages of history a room retains and replays to joiners.
MAX_ROOM_HISTORY=200

# Seconds an empty room is kept alive before it is destroyed. Gives the last
# participant a window to reload the page without losing the room.
EMPTY_ROOM_TTL_SECONDS=60
