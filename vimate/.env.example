# ---------------------------------------------------------------------------
# VI.mate frontend
# Copy to `.env` (or `.env.local`) and adjust.
#
# Only variables prefixed with VITE_ are exposed to the browser. Everything in
# this file ends up readable in the shipped bundle — never put a secret here.
# TURN credentials in particular are served at runtime from the signaling
# server's /api/ice endpoint precisely so they do NOT live in the bundle.
# ---------------------------------------------------------------------------

# Base URL of the signaling server (Socket.IO + /api/ice).
# Leave unset to fall back to the page's own origin, which is what you want
# when the frontend and signaling server sit behind the same domain.
#
# Local development (frontend on :5173, server on :8000):
VITE_SIGNALING_URL=http://localhost:8000

# Production must be https/wss — getUserMedia and getDisplayMedia are only
# available in secure contexts, so an http:// deployment cannot access the
# camera at all.
# VITE_SIGNALING_URL=https://signal.vimate.example.com

# Optional: label shown in the lobby's diagnostics readout. Handy when you run
# staging and production side by side.
# VITE_DEPLOY_LABEL=staging
